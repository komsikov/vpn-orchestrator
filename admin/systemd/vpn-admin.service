[Unit]
Description=VPN Admin web panel
Requires=vpn-admin-worker.socket
After=vpn-admin-worker.socket

[Service]
Type=exec
User=vpn-admin
Group=vpn-admin
UMask=0077
ExecStart=/usr/bin/python3 -Es /usr/local/libexec/vpn-orchestrator/admin/web.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
TasksMax=64
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
